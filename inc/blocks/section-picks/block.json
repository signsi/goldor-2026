{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "goldor/section-picks",
	"title": "Section Picks",
	"category": "goldor",
	"icon": "grid-view",
	"description": "A homepage section listing posts of one type, as story cards, a date list, a lead with a list, or a table, with an optional taxonomy filter and an ad override.",
	"textdomain": "goldor",
	"editorScript": "goldor-block-section-picks-edit",
	"render": "file:./render.php",
	"attributes": {
		"heading": { "type": "string", "default": "" },
		"headingStyle": { "type": "string", "default": "section" },
		"postType": { "type": "string", "default": "post" },
		"postsPerPage": { "type": "number", "default": 3 },
		"offset": { "type": "number", "default": 0 },
		"excludeTopstory": { "type": "boolean", "default": false },
		"layout": { "type": "string", "default": "grid" },
		"variant": { "type": "string", "default": "card" },
		"taxonomy": { "type": "string", "default": "" },
		"term": { "type": "string", "default": "" },
		"archiveLink": { "type": "string", "default": "" },
		"linkLabel": { "type": "string", "default": "" },
		"adOverride": { "type": "string", "default": "" },
		"ignoreRendered": { "type": "boolean", "default": false },
		"actionLabel": { "type": "string", "default": "" },
		"actionLink": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false
	}
}
