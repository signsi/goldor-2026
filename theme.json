{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#000000", "name": "Contrast" },
        { "slug": "primary", "color": "#e6007e", "name": "Primary" },
        { "slug": "muted", "color": "#5a5a5a", "name": "Muted" },
        { "slug": "surface", "color": "#ffffff", "name": "Surface" }
      ]
    },
    "layout": {
      "contentSize": "780px",
      "wideSize": "1200px"
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "3rem", "name": "Huge" }
      ],
      "fontFamilies": [
        { "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "name": "System Sans", "slug": "system-sans" },
        { "fontFamily": "'Work Sans', sans-serif", "name": "Work Sans", "slug": "work-sans" },
        { "fontFamily": "'Playfair Display', serif", "name": "Playfair Display", "slug": "playfair-display" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|work-sans",
      "lineHeight": "1.6",
      "fontSize": "var:preset|font-size|medium"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|playfair-display",
          "fontWeight": "200"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|playfair-display",
          "fontSize": "var:preset|font-size|x-large",
          "fontWeight": "700"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|playfair-display",
          "fontSize": "var:preset|font-size|xx-large",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      }
    }
  }
}
