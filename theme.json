{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "customTemplates": [
    { "name": "template-text", "title": "Text Seite", "postTypes": ["page"] },
    { "name": "template-form", "title": "Formular Seite", "postTypes": ["page"] }
  ],
  "settings": {
    "appearanceTools": false,
    "background": { "backgroundImage": false, "backgroundSize": false },
    "border": { "color": false, "radius": false, "style": false, "width": false },
    "dimensions": { "aspectRatio": false, "minHeight": false },
    "position": { "fixed": false, "sticky": false },
    "shadow": { "defaultPresets": false, "presets": [] },
    "color": {
      "background": false,
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "heading": false,
      "button": false,
      "link": false,
      "text": false,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#16181d", "name": "Contrast" },
        { "slug": "primary", "color": "#e6007e", "name": "Primary" },
        { "slug": "primary-dark", "color": "#c30069", "name": "Primary dark" },
        { "slug": "deep", "color": "#0e3742", "name": "Deep" },
        { "slug": "sand", "color": "#f6f4f0", "name": "Sand" },
        { "slug": "muted", "color": "#5a5f66", "name": "Muted" },
        { "slug": "line", "color": "#e5e2dc", "name": "Line" }
      ]
    },
    "layout": {
      "allowCustomContentAndWideSize": false,
      "allowEditing": false,
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "spacing": {
      "blockGap": false,
      "customSpacingSize": false,
      "margin": false,
      "padding": false,
      "units": ["px", "%", "em", "rem", "vh", "vw"],
      "spacingSizes": [
        { "slug": "10", "size": "0.5rem", "name": "1" },
        { "slug": "20", "size": "1rem", "name": "2" },
        { "slug": "30", "size": "1.5rem", "name": "3" },
        { "slug": "40", "size": "2.5rem", "name": "4" },
        { "slug": "50", "size": "clamp(3.5rem, 6vw, 5.5rem)", "name": "5" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "lineHeight": false,
      "textAlign": false,
      "textColumns": false,
      "textDecoration": false,
      "textTransform": false,
      "writingMode": false,
      "fluid": true,
      "fontSizes": [
        { "slug": "tiny", "size": "0.75rem", "name": "Tiny" },
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "2.5rem", "name": "Huge" },
        { "slug": "list", "size": "1.125rem", "name": "List title" },
        { "slug": "card", "size": "1.375rem", "name": "Card title" },
        { "slug": "h2", "size": "clamp(1.625rem, 3vw, 2rem)", "name": "H2", "fluid": false },
        { "slug": "h1", "size": "clamp(2rem, 4vw, 2.75rem)", "name": "H1", "fluid": false },
        { "slug": "display", "size": "clamp(2.5rem, 5.2vw, 3.75rem)", "name": "Display", "fluid": false }
      ],
      "fontFamilies": [
        { "fontFamily": "'Arvo', Rockwell, 'Roboto Slab', Georgia, serif", "name": "Arvo (Headings)", "slug": "arvo" },
        { "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif", "name": "Inter (Text & UI)", "slug": "inter" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|inter",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "fontSize": "var:preset|font-size|medium"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|arvo",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary-dark"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|base"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.7rem",
            "bottom": "0.7rem",
            "left": "1.6rem",
            "right": "1.6rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|inter",
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "500",
          "lineHeight": "1.2"
        }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|arvo",
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "700"
        }
      },
      "core/post-title": {
        "typography": {
          "fontFamily": "var:preset|font-family|arvo",
          "fontSize": "var:preset|font-size|h1",
          "fontWeight": "700",
          "lineHeight": "1.06"
        }
      }
    }
  }
}
